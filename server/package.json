{
  "name": "@pinnode/server",
  "version": "1.0.0",
  "description": "PINnode Backend - Express + Node",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "tsc --noEmit",
    "lint": "eslint server --ext .ts",
    "lint:fix": "eslint server --ext .ts --fix",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "bullmq": "^5.66.2",
    "compression": "^1.8.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "openai": "^5.11.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "redis": "^5.10.0",
    "sharp": "^0.34.3",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/compression": "^1.7.5",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "20.16.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
