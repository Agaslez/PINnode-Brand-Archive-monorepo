# PINnode System Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pinnode_db
POSTGRES_USER=pinnode_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=pinnode_production

# AI Service API Keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here

# Payment Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# Application Configuration
NODE_ENV=production
PORT=5000
SESSION_SECRET=your-super-secure-session-secret-here

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-jwt-secret-for-auth
ENCRYPTION_KEY=your-32-character-encryption-key

# External Services
VERCEL_TOKEN=your_vercel_deployment_token
RENDER_API_KEY=your_render_api_key

# Development (only needed for local development)
VITE_API_URL=http://localhost:5000
VITE_ENVIRONMENT=development